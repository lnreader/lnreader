{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrochapterlist"
  ],
  "ios": {
    "iosModuleName": "NitroChapterList"
  },
  "android": {
    "androidNamespace": [
      "nitrochapterlist"
    ],
    "androidCxxLibName": "NitroChapterList"
  },
  "autolinking": {
    "ChapterListStore": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridChapterListStore"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "src/fabric"
  ]
}
